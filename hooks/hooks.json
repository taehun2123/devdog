{
  "description": "ko-tech-writing: 문서·주석 작성 후 문체 검사, git commit 전 커밋 제목 검사",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/kolint.py\" --hook post",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/kolint.py\" --hook pre",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
