{
  "name": "project-documentation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:prepare": "node scripts/site/prepare.mjs",
    "docs:dev": "node scripts/site/dev.mjs",
    "docs:build": "npm run docs:prepare && vitepress build site && node scripts/site/check-output.mjs",
    "docs:preview": "node scripts/site/preview.mjs",
    "docs:check": "npm run docs:prepare && node --test tests/site/*.test.mjs",
    "test": "node --test tests/site/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@playwright/test": "1.63.0",
    "cheerio": "1.1.2",
    "chokidar": "4.0.3",
    "markdown-it": "14.3.2",
    "mermaid": "11.17.2",
    "vitepress": "1.6.4",
    "vue": "3.5.22"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
